<Project>
    <PropertyGroup>
        <LangVersion>latest</LangVersion>
        <!--
            Project-local on purpose. With `$(SolutionDir)obj\` a solution build relocated these
            intermediates to the solution root, the SDK's default exclude no longer covered the
            stale `src/obj` from an earlier project build, and the two generated AssemblyInfos
            collided (CS0579).
        -->
        <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj\</BaseIntermediateOutputPath>
        <BaseOutputPath>$(SolutionDir)..\bin\</BaseOutputPath>
    </PropertyGroup>
</Project>
